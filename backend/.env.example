# Lokaler Betrieb: Kopie als backend/.env anlegen. Vorhandene Umgebungsvariablen haben Vorrang.
KALENDER_BACKEND=local
# none = fester Benutzer ohne Anmeldung, Kalender als lokale Attrappe (nur lokal erlaubt)
KALENDER_AUTH=none
# 1 = ohne KI-Kosten: feste Beispielaufnahme statt OpenRouter
KALENDER_FAKE_LLM=1
# OPENROUTER_API_KEY=sk-or-v1-...

# Echte Google-Anmeldung lokal (KALENDER_AUTH=google):
# GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=...
# KALENDER_ALLOWED_EMAILS=du@example.com
# KALENDER_SESSION_SECRET=beliebige-lange-zeichenkette

# Erinnerungen per Push: Ohne Schlüssel erzeugt der Server lokal selbst einen (backend/data/store.json).
# Den Erinnerungslauf lokal von Hand anstoßen (ohne KALENDER_CRON_SECRET frei):
#   curl -X POST -H "X-Kalender: 1" http://localhost:8080/api/cron/reminders
# KALENDER_VAPID_PRIVATE_KEY=...
# KALENDER_CRON_SECRET=...
